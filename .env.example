# Supabase Postgres connection string. Use the *direct* connection (not the
# pgbouncer transaction-mode pooler) since this app holds a small persistent
# asyncpg pool itself - Project Settings -> Database -> Connection string -> URI.
# Add ?sslmode=require if you're not using Supabase's pooler host.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# Optional bootstrap defaults - all of these can also be set/changed later
# from the Settings panel in the dashboard without redeploying.
ARCADIA_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polling tuning - defaults match the spec, override only if you want to
# experiment with different cadences.
# POLL_BASE_INTERVAL=30
# POLL_BACKOFF_STEP=15
# POLL_MAX_INTERVAL=120
# POLL_JITTER_MIN=1.0
# POLL_JITTER_MAX=3.5

PORT=8000
